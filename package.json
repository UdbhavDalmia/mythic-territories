{
  "name": "mythic-territories",
  "version": "2.1.0",
  "description": "Turn-based strategy game with Socket.io multiplayer",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "build": "npm run --prefix client build",
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "client:dev": "npm run --prefix client dev",
    "client:build": "npm run --prefix client build",
    "dev:full": "concurrently \"npm run dev\" \"npm run client:dev\""
  },
  "dependencies": {
    "express": "^4.22.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
